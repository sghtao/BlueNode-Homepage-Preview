---
import NoomoSubpageShell from '../../components/noomo/NoomoSubpageShell.astro'
import { orgProfile } from '../../data/orgFacts'
import Layout from '../../layouts/Layout.astro'
import { withBase } from '../../lib/paths'

const title = 'About BlueNode'
const description = '변화를 읽고 움직이는 사람들이 모이는 곳, BlueNode의 시작과 원칙을 소개합니다.'
---

<Layout title={title} description={description}>
  <NoomoSubpageShell current="about">
    <section class="about-hero" aria-labelledby="about-route-heading">
      <div>
        <p class="route-eyebrow">ABOUT / OUR STORY</p>
        <h1 class="route-statement" id="about-route-heading">ABOUT BLUENODE</h1>
      </div>
      <div class="about-hero__meta">
        <span>WHERE THOSE WHO READ CHANGE AND ACT COME TOGETHER.</span>
        <span>INHA UNIVERSITY · INCHEON</span>
      </div>
    </section>

    <section class="about-origin" aria-labelledby="about-origin-heading">
      <p class="route-eyebrow">ABOUT / ORIGIN</p>
      <h2 class="route-section-title" id="about-origin-heading">OUR ORIGIN</h2>
      <div class="about-origin__grid">
        <div class="about-origin__visual">
          <img
            src={withBase('/images/noomo-prototype/bluenode-white-vertical.png')}
            width="443"
            height="265"
            alt="BlueNode"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="about-origin__copy">
          <p>
            BlueNode는 2023년 7월, 인하대학교를 기반으로 시작한 student-led 블록체인
            리서치 커뮤니티입니다. 공부에서 얻은 질문을 세션, 연구, 빌드와 활동으로
            이어갑니다.
          </p>
          <dl class="about-facts">
            <div><dt>FOUNDED</dt><dd>{orgProfile.foundedMonth} {orgProfile.foundedYear}</dd></div>
            <div><dt>COMMUNITY</dt><dd>{orgProfile.approximateMemberCount}+</dd></div>
            <div><dt>BASE</dt><dd>INHA UNIVERSITY</dd></div>
            <div><dt>IDENTITY</dt><dd>STUDENT-LED / NON-COMMERCIAL</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="about-principles" aria-labelledby="about-principles-heading">
      <p class="route-eyebrow">ABOUT / PRINCIPLES</p>
      <h2 class="route-section-title" id="about-principles-heading">OUR PRINCIPLES</h2>
      <ol class="principles-list">
        <li><span>01</span><strong>READ CHANGE DEEPLY</strong></li>
        <li><span>02</span><strong>TURN LEARNING INTO QUESTIONS</strong></li>
        <li><span>03</span><strong>TURN QUESTIONS INTO ACTION</strong></li>
      </ol>
    </section>

    <section class="about-people" aria-labelledby="about-people-heading">
      <p class="route-eyebrow">ABOUT / PEOPLE</p>
      <h2 class="route-section-title" id="about-people-heading">OUR PEOPLE</h2>
      <p>
        약 {orgProfile.approximateMemberCount}명의 구성원이 서로 다른 관심과 경험을 연결해
        배우고, 질문하고, 실제 결과를 만들어갑니다.
      </p>
      <a class="route-inline-cta" href={withBase('join/')}>MEET BLUENODE <span>→</span></a>
    </section>
  </NoomoSubpageShell>
</Layout>
