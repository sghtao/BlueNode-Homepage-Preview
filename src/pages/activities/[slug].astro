---
import NoomoSubpageShell from '../../components/noomo/NoomoSubpageShell.astro'
import {
  activityArchive,
  getActivityBySlug,
  type ActivityArchiveItem,
} from '../../data/activityArchive'
import Layout from '../../layouts/Layout.astro'
import { withBase } from '../../lib/paths'

export function getStaticPaths() {
  return activityArchive.map((activity) => ({
    params: { slug: activity.slug },
    props: { activity },
  }))
}

interface Props {
  activity: ActivityArchiveItem
}

const { activity } = Astro.props
const related = activity.relatedSlugs
  .map((slug) => getActivityBySlug(slug))
  .find((candidate): candidate is ActivityArchiveItem => Boolean(candidate))
const title = `${activity.title} — Activities | BlueNode`
const description = activity.summary
---

<Layout title={title} description={description}>
  <NoomoSubpageShell current="activities">
    <header class="route-intro">
      <p class="route-eyebrow">ACTIVITY DETAIL / {activity.kind}</p>
      <h1 class="route-title route-title--detail">{activity.title}</h1>
    </header>

    <figure class="activity-detail-hero">
      <img
        src={withBase(activity.src)}
        width={activity.width}
        height={activity.height}
        alt={activity.alt}
        decoding="async"
        fetchpriority="high"
        style={`object-position:${activity.objectPosition}`}
      />
    </figure>

    <dl class="activity-detail-meta">
      <div>
        <dt>ACTIVITY TYPE</dt>
        <dd>{activity.kind}</dd>
      </div>
      <div>
        <dt>BLUENODE’S RECORD</dt>
        <dd>Photo archive</dd>
      </div>
      {activity.result && (
        <div>
          <dt>OUTCOME</dt>
          <dd>{activity.result}</dd>
        </div>
      )}
      <div>
        <dt>EVIDENCE</dt>
        <dd>Verified title and archived media</dd>
      </div>
    </dl>

    <section class="route-story" aria-labelledby="activity-story-heading">
      <h2 class="route-section-title" id="activity-story-heading">THE STORY</h2>
      <p>{activity.summary}</p>
    </section>

    {related && (
      <a class="activity-detail-next" href={withBase(`activities/${related.slug}/`)}>
        <span>NEXT ACTIVITY</span>
        <strong>{related.title} →</strong>
      </a>
    )}
  </NoomoSubpageShell>
</Layout>
