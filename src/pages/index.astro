---
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'
import AboutFacts from '../components/AboutFacts.astro'
import ActivitiesStage from '../components/ActivitiesStage.astro'
import AwardsArchive from '../components/AwardsArchive.astro'
import Hero from '../components/Hero.astro'
import JoinCTA from '../components/JoinCTA.astro'
import NetworkSection from '../components/NetworkSection.astro'
import ResearchIndex from '../components/ResearchIndex.astro'
import TeamsIndex from '../components/TeamsIndex.astro'
import { getMediumFeedArticles } from '../lib/medium'
import Layout from '../layouts/Layout.astro'

const articles = await getMediumFeedArticles()
---

<Layout home>
  <div class="depth-backdrop" aria-hidden="true"></div>
  <canvas class="noise-canvas" data-noise-canvas aria-hidden="true"></canvas>
  <Header depthAware entry />

  <main id="main" tabindex="-1">
    <Hero />
    <AboutFacts />
    <TeamsIndex />
    <ActivitiesStage />
    <AwardsArchive />

    <ResearchIndex articles={articles} />

    <NetworkSection />

    <JoinCTA />
  </main>

  <Footer />

<script>
  const root = document.documentElement
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
  const finePointer = matchMedia('(pointer: fine)').matches
  const saveData = Boolean(
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData,
  )
  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value))

  // Timed reveals play once. The opt-in class is added only after the observer
  // exists, so a script failure never leaves content permanently transparent.
  try {
    const reveals = [...document.querySelectorAll<HTMLElement>('.rv, .stagger')]
    if (reduced || !('IntersectionObserver' in window)) {
      reveals.forEach((element) => element.classList.add('in'))
    } else {
      document.querySelectorAll<HTMLElement>('.stagger').forEach((group) => {
        ;[...group.children].forEach((child, index) => {
          ;(child as HTMLElement).style.setProperty('--reveal-delay', Math.min(index * 0.06, 0.42) + 's')
        })
      })
      root.classList.add('reveal-ready')
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            entry.target.classList.add('in')
            observer.unobserve(entry.target)
          })
        },
        { threshold: 0.15, rootMargin: '0px 0px -6% 0px' },
      )
      reveals.forEach((element) => observer.observe(element))
    }
  } catch {
    root.classList.remove('reveal-ready')
    document.querySelectorAll('.rv, .stagger').forEach((element) => element.classList.add('in'))
  }

  // Bidirectional scroll scrub: one normalized progress value drives the water
  // tone, masthead, parallax, and GPU uniforms in the legacy sections.
  try {
    const header = document.querySelector<HTMLElement>('.hdr--depth')
    const record = document.getElementById('awards')
    const parallaxItems = [...document.querySelectorAll<HTMLElement>('[data-parallax]')]
    const depthStops: Array<[number, [number, number, number]]> = [
      [0, [234, 241, 251]],
      [0.09, [222, 233, 248]],
      [0.2, [198, 216, 240]],
      [0.38, [124, 157, 214]],
      [0.49, [51, 85, 160]],
      [0.58, [27, 55, 113]],
      [0.7, [19, 44, 92]],
      [0.84, [13, 34, 73]],
      [1, [8, 23, 51]],
    ]
    let maxScroll = 1
    let scrubFrame = 0
    let measureFrame = 0

    const colorAt = (progress: number) => {
      for (let index = 1; index < depthStops.length; index += 1) {
        if (progress > depthStops[index][0]) continue
        const before = depthStops[index - 1]
        const after = depthStops[index]
        const mix = (progress - before[0]) / (after[0] - before[0])
        return before[1].map((value, channel) =>
          Math.round(value + (after[1][channel] - value) * mix),
        )
      }
      return depthStops.at(-1)![1]
    }

    const renderScrub = () => {
      scrubFrame = 0
      const scrollTop = scrollY || pageYOffset
      const progress = clamp(scrollTop / maxScroll, 0, 1)
      root.style.setProperty('--scroll-progress', progress.toFixed(5))
      if (!reduced) {
        root.style.setProperty('--depth-rgb', colorAt(progress).join(','))
        parallaxItems.forEach((element) => {
          const rect = element.getBoundingClientRect()
          const local = clamp((innerHeight - rect.top) / (innerHeight + rect.height), 0, 1)
          const distance = Number(element.dataset.parallax || 24)
          element.style.setProperty('--parallax-y', ((local - 0.5) * distance).toFixed(2) + 'px')
        })
      }
      const recordTop = record
        ? record.getBoundingClientRect().top + scrollTop
        : maxScroll * 0.55
      header?.classList.toggle('hdr--deep', scrollTop + (header.offsetHeight || 0) >= recordTop)
      dispatchEvent(new CustomEvent('bluenode:scrub', { detail: { progress } }))
    }

    const requestScrub = () => {
      if (!scrubFrame) scrubFrame = requestAnimationFrame(renderScrub)
    }
    const measure = () => {
      measureFrame = 0
      maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight)
      requestScrub()
    }
    const requestMeasure = () => {
      if (measureFrame) cancelAnimationFrame(measureFrame)
      measureFrame = requestAnimationFrame(measure)
    }

    addEventListener('scroll', requestScrub, { passive: true })
    addEventListener('resize', requestMeasure, { passive: true })
    addEventListener('load', requestMeasure, { once: true })
    document.fonts?.ready.then(requestMeasure)
    if ('ResizeObserver' in window) new ResizeObserver(requestMeasure).observe(document.body)
    measure()
  } catch {
    root.classList.remove('reveal-ready')
    document.querySelectorAll('.rv, .stagger').forEach((element) => element.classList.add('in'))
  }

  // Fine-pointer wheel smoothing only. Touch, keyboard, anchors, RM, and
  // Save-Data retain native scrolling.
  try {
    if (finePointer && !reduced && !saveData) {
      let targetY = scrollY
      let currentY = targetY
      let wheelFrame = 0
      let wheelActive = false
      let lastWheel = performance.now()
      let lastFrame = lastWheel
      let inputVelocity = 0
      const maxY = () => Math.max(0, document.documentElement.scrollHeight - innerHeight)

      const tick = (now: number) => {
        const deltaTime = Math.min(34, Math.max(8, now - lastFrame))
        lastFrame = now
        const gap = targetY - currentY
        const fast = inputVelocity > 900 || Math.abs(gap) > innerHeight * 0.65
        const lerpRetention = fast ? 0.065 : 0.095
        const retention = Math.pow(lerpRetention, deltaTime / 16.667)
        currentY = targetY + (currentY - targetY) * retention
        scrollTo({ left: scrollX, top: currentY, behavior: 'instant' })
        inputVelocity *= 0.82
        if (Math.abs(targetY - currentY) < 0.35) {
          currentY = targetY
          scrollTo({ left: scrollX, top: currentY, behavior: 'instant' })
          wheelFrame = 0
          wheelActive = false
          return
        }
        wheelFrame = requestAnimationFrame(tick)
      }

      const cancelDamping = () => {
        if (wheelFrame) cancelAnimationFrame(wheelFrame)
        wheelFrame = 0
        targetY = currentY = scrollY
        wheelActive = false
      }

      addEventListener(
        'wheel',
        (event) => {
          if (event.ctrlKey || event.defaultPrevented) return
          let delta = event.deltaY
          if (event.deltaMode === 1) delta *= 16
          else if (event.deltaMode === 2) delta *= innerHeight
          event.preventDefault()
          const now = performance.now()
          inputVelocity = Math.abs(delta) / (Math.max(12, now - lastWheel) / 1000)
          lastWheel = now
          if (!wheelActive) {
            targetY = currentY = scrollY
            wheelActive = true
            lastFrame = now
          }
          targetY = clamp(targetY + delta, 0, maxY())
          if (!wheelFrame) wheelFrame = requestAnimationFrame(tick)
        },
        { passive: false },
      )
      addEventListener('scroll', () => {
        if (!wheelActive && !wheelFrame) targetY = currentY = scrollY
      }, { passive: true })
      document.addEventListener('click', (event) => {
        if ((event.target as Element).closest?.('a[href*="#"]')) cancelDamping()
      })
      addEventListener('keydown', cancelDamping)
      addEventListener('mousedown', cancelDamping, { passive: true })
      addEventListener('touchstart', cancelDamping, { passive: true })
    }
  } catch {
    // Native scroll remains available.
  }

  // Low-resolution paper grain. RM and Save-Data receive one deterministic frame.
  try {
    const noise = document.querySelector<HTMLCanvasElement>('[data-noise-canvas]')
    const context = noise?.getContext('2d', { alpha: true })
    if (noise && context) {
      const width = 96
      const height = 96
      noise.width = width
      noise.height = height
      let seed = 0x243f6a88
      let frame = 0
      let lastDraw = 0
      const randomByte = () => {
        seed ^= seed << 13
        seed ^= seed >>> 17
        seed ^= seed << 5
        return seed >>> 24
      }
      const draw = () => {
        const image = context.createImageData(width, height)
        for (let index = 0; index < image.data.length; index += 4) {
          const value = randomByte()
          image.data[index] = value
          image.data[index + 1] = value
          image.data[index + 2] = value
          image.data[index + 3] = 150
        }
        context.putImageData(image, 0, 0)
      }
      const animate = (now: number) => {
        if (now - lastDraw > 80) {
          draw()
          lastDraw = now
        }
        frame = requestAnimationFrame(animate)
      }
      draw()
      if (!reduced && !saveData) frame = requestAnimationFrame(animate)
      document.addEventListener('visibilitychange', () => {
        if (document.hidden && frame) {
          cancelAnimationFrame(frame)
          frame = 0
        } else if (!document.hidden && !reduced && !saveData && !frame) {
          frame = requestAnimationFrame(animate)
        }
      })
    }
  } catch {
    document.querySelector<HTMLElement>('[data-noise-canvas]')?.setAttribute('hidden', '')
  }
</script>
</Layout>
