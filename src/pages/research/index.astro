---
import NoomoSubpageShell from '../../components/noomo/NoomoSubpageShell.astro'
import { getMediumFeedArticles } from '../../lib/medium'
import Layout from '../../layouts/Layout.astro'
import { withBase } from '../../lib/paths'

const articles = await getMediumFeedArticles()
const featured = articles.find((article) => article.thumbnail) ?? articles[0]
const archive = articles.filter((article) => article.recordId !== featured?.recordId)
const title = 'Research — BlueNode'
const description = `BlueNode가 공부하며 정리한 블록체인·Web3 글 ${articles.length}편을 살펴보세요.`
---

<Layout title={title} description={description}>
  <NoomoSubpageShell current="research">
    <header class="route-intro">
      <p class="route-eyebrow">PUBLICATION / RESEARCH</p>
      <h1 class="route-title">RESEARCH</h1>
      <p class="route-intro-copy">
        공부하며 생긴 질문을 기록하고, 다른 사람이 다시 검증할 수 있는 글로 남깁니다.
      </p>
    </header>

    {featured && (
      <a class="research-feature" href={featured.externalUrl} target="_blank" rel="noopener noreferrer">
        {featured.thumbnail && (
          <img
            src={withBase(featured.thumbnail.src)}
            width={featured.thumbnail.width}
            height={featured.thumbnail.height}
            alt=""
            decoding="async"
            fetchpriority="high"
          />
        )}
        <span class="research-feature__copy">
          <span>FEATURED RESEARCH · {featured.tags[0] ?? 'BLUENODE'}</span>
          <strong>{featured.title}</strong>
        </span>
      </a>
    )}

    <ol class="research-archive">
      {archive.map((article) => (
        <li>
          <a href={article.externalUrl} target="_blank" rel="noopener noreferrer">
            <time datetime={article.publishedAt}>{article.publishedAt.replaceAll('-', '.')}</time>
            <strong>{article.title}</strong>
            <small>{article.tags.slice(0, 2).join(' / ') || 'RESEARCH'}</small>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </NoomoSubpageShell>
</Layout>
