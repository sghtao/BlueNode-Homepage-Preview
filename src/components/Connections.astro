---
import { connections } from '../data/connections'
import { withBase } from '../lib/paths'
---

<section class="connections beat on-dark" id="connections" aria-labelledby="connections-title">
  <div class="wrap">
    <div class="runhead">
      <h2 class="sig" id="connections-title">
        <span class="no">05</span>
        <span class="sep">/</span>
        <span class="ko">커넥션</span>
        <span class="sep">·</span>
        <span class="en">Network</span>
      </h2>
      <span class="count"><b>{connections.length}</b> 노드 · Verified</span>
    </div>
  </div>

  <div class="ticker">
    <div class="viewport" tabindex="0" role="group" aria-label="BlueNode 커넥션 마크">
      <div class="track">
        <div class="set">
          {connections.map((connection) => (
            <div class="card">
              <div class="plate">
                <div
                  class:list={[
                    'mark',
                    { dim: connection.slug === 'solana' },
                  ]}
                >
                  <img
                    src={withBase(connection.logoSrc)}
                    width={connection.w}
                    height={connection.h}
                    alt={connection.name}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <div class="cap">{connection.name}</div>
            </div>
          ))}
        </div>

        <div class="set" aria-hidden="true">
          {connections.map((connection) => (
            <div class="card">
              <div class="plate">
                <div
                  class:list={[
                    'mark',
                    { dim: connection.slug === 'solana' },
                  ]}
                >
                  <img
                    src={withBase(connection.logoSrc)}
                    width={connection.w}
                    height={connection.h}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <div class="cap">{connection.name}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="wrap foot-wrap">
    <p class="foot">— 확인된 커넥션 마크. 로고는 원본 그대로 표기합니다.</p>
  </div>
</section>

<style>
  .connections {
    --gap: clamp(0.75rem, 1.5vw, 1.25rem);
    --card: rgba(255, 255, 255, 0.025);
    --card-highlight: rgba(255, 255, 255, 0.055);
    color: var(--paper-text);
    border-top: 1px solid var(--line-dark);
    background: rgba(8, 23, 51, 0.34);
  }

  .runhead .sig {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    color: var(--paper-text);
    font-size: var(--fs-h2);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.028em;
  }

  .runhead .sep {
    align-self: center;
    color: var(--paper-faint);
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .runhead .no,
  .runhead .count b {
    color: var(--brand-bright);
    font-weight: 500;
  }

  .runhead .no,
  .runhead .en,
  .runhead .count {
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .runhead .no {
    align-self: center;
    font-size: var(--fs-mono);
  }

  .runhead .ko {
    font-weight: 350;
  }

  .runhead .en {
    align-self: center;
    color: var(--paper-faint);
    font-size: var(--fs-cap);
  }

  .runhead .count {
    margin-left: auto;
    color: var(--paper-faint);
    font-size: var(--fs-mono);
  }

  .ticker {
    width: 100%;
    margin-top: clamp(0.25rem, 1vw, 0.625rem);
  }

  .viewport {
    position: relative;
    overflow: hidden;
    padding-block: clamp(0.875rem, 1.6vw, 1.25rem);
    animation: reveal 0.6s ease both;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 52s linear infinite;
    will-change: transform;
  }

  .set {
    display: flex;
    gap: var(--gap);
    padding-right: var(--gap);
  }

  .viewport:hover .track,
  .viewport:focus-within .track {
    animation-play-state: paused;
  }

  .card {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    width: clamp(9.375rem, 15.5vw, 11.375rem);
    padding: clamp(1.125rem, 2.1vw, 1.625rem) clamp(0.875rem, 1.7vw, 1.375rem)
      clamp(0.8125rem, 1.5vw, 1.0625rem);
    border: 1px solid var(--line-dark);
    border-radius: 1rem;
    background: var(--card);
    transition:
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .plate {
    display: grid;
    place-items: center;
    width: 100%;
    height: clamp(3.375rem, 7vw, 4.5rem);
  }

  .mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .mark img {
    width: auto;
    height: auto;
    max-width: min(8.75rem, 100%);
    max-height: 2.5rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.76;
    transition:
      filter 0.32s ease,
      opacity 0.32s ease;
  }

  .mark.dim img {
    width: auto;
    height: 1.875rem;
  }

  .card:hover,
  .card:focus-within {
    border-color: rgba(244, 233, 39, 0.42);
    background: var(--card-highlight);
    box-shadow: 0 1rem 2.125rem rgba(2, 10, 30, 0.42);
    transform: translateY(-0.25rem);
  }

  .card:hover .mark img,
  .card:focus-within .mark img {
    opacity: 1;
  }

  .cap {
    margin-top: clamp(0.6875rem, 1.3vw, 0.9375rem);
    color: var(--paper-faint);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
    transition: color 0.22s ease;
  }

  .cap::after {
    display: block;
    width: 0.875rem;
    height: 0.125rem;
    margin: 0.4375rem auto 0;
    background: var(--signal);
    content: "";
    opacity: 0;
    transform: scaleX(0.4);
    transform-origin: center;
    transition:
      opacity 0.24s ease,
      transform 0.24s ease;
  }

  .card:hover .cap,
  .card:focus-within .cap {
    color: var(--paper-text);
  }

  .card:hover .cap::after,
  .card:focus-within .cap::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .foot-wrap {
    padding-top: 0;
  }

  .foot {
    margin: clamp(1.875rem, 4vw, 3rem) 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line-dark);
    color: var(--paper-faint);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @keyframes reveal {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewport {
      overflow-x: auto;
      overflow-y: hidden;
      animation: none;
      scroll-snap-type: x proximity;
      -webkit-mask-image: none;
      mask-image: none;
      -webkit-overflow-scrolling: touch;
    }

    .track {
      animation: none;
      will-change: auto;
    }

    .set[aria-hidden="true"] {
      display: none;
    }

    .set {
      padding-right: 0;
    }

    .card {
      scroll-snap-align: center;
      transition: none;
    }

    .card:hover,
    .card:focus-within {
      transform: none;
    }

    .mark img,
    .cap,
    .cap::after {
      transition: none;
    }
  }
</style>
