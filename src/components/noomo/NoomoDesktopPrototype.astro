---
import { activities } from '../../data/activities'
import { researchArticles } from '../../data/research'
import { withBase } from '../../lib/paths'
import '@fontsource/instrument-sans/latin-700.css'
import '@fontsource/inter/latin-400.css'
import '@fontsource/inter/latin-500.css'
import '@fontsource/inter/latin-600.css'
import '@fontsource/inter/latin-700.css'

const activityReel = [
  {
    ...activities[0],
    src: '/images/noomo-prototype/activities/mantle-hackathon.jpeg',
    width: 4032,
    height: 3024,
    displayTitle: 'MANTLE HACKATHON',
  },
  { ...activities[4], displayTitle: 'BUIDLHACK' },
  { ...activities[1], displayTitle: 'TIGER RESEARCH' },
  { ...activities[2], displayTitle: 'NINJA LABS SESSION' },
]

const awards = [
  'Arbitrum Mini Hackathon — 1st Place',
  'BUIDL Hack · BNB Chain Track — 1st Place',
  'KOBAC (Korea Blockchain Society Conference) — Winner',
  'XRP Ledger × Biconomy Track — Winner',
  'BUIDL AI Hackathon Upstage — 2nd Place',
  'BUIDL AI Hackathon Upstage — 3rd Place',
  'Build on QuickNode · PYUSD Track — 1st Place',
]

const research = researchArticles.slice(0, 3)
const formatResearchDisplayDate = (publishedAt: string) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  })
    .format(new Date(`${publishedAt}T00:00:00Z`))
    .toUpperCase()
const researchDisplay = [
  { meta: 'ORACLE' },
  { meta: 'STABLECOIN' },
  { meta: 'ETHEREUM' },
]

const responsiveBackgroundOrbs = [
  { name: 'milk', src: '/images/noomo-prototype/background/milk-cloud.svg', width: 610, height: 500 },
  { name: 'ivory', src: '/images/noomo-prototype/background/ivory-patch.svg', width: 540, height: 440 },
  { name: 'cool', src: '/images/noomo-prototype/background/cool-white.svg', width: 570, height: 650 },
  { name: 'pearl', src: '/images/noomo-prototype/background/pearl-wash.svg', width: 720, height: 430 },
  { name: 'ice', src: '/images/noomo-prototype/background/ice-flash.svg', width: 500, height: 360 },
]
---

<main class="prototype-shell" data-prototype-root>
  <div class="prototype-viewport" data-prototype-viewport>
    <div class="prototype-atmosphere" data-prototype-atmosphere aria-hidden="true">
      <img
        class="prototype-atmosphere__orb prototype-atmosphere__orb--milk"
        src={withBase('/images/noomo-prototype/background/milk-cloud.svg')}
        width="610"
        height="500"
        alt=""
        data-background-orb="milk"
      />
      <img
        class="prototype-atmosphere__orb prototype-atmosphere__orb--ivory"
        src={withBase('/images/noomo-prototype/background/ivory-patch.svg')}
        width="540"
        height="440"
        alt=""
        data-background-orb="ivory"
      />
      <img
        class="prototype-atmosphere__orb prototype-atmosphere__orb--cool"
        src={withBase('/images/noomo-prototype/background/cool-white.svg')}
        width="570"
        height="650"
        alt=""
        data-background-orb="cool"
      />
      <img
        class="prototype-atmosphere__orb prototype-atmosphere__orb--pearl"
        src={withBase('/images/noomo-prototype/background/pearl-wash.svg')}
        width="720"
        height="430"
        alt=""
        data-background-orb="pearl"
      />
      <img
        class="prototype-atmosphere__orb prototype-atmosphere__orb--ice"
        src={withBase('/images/noomo-prototype/background/ice-flash.svg')}
        width="500"
        height="360"
        alt=""
        data-background-orb="ice"
      />
      <span class="prototype-atmosphere__texture"></span>
    </div>

    <header class="prototype-header" data-prototype-header>
      <button class="prototype-header__brand" type="button" data-jump-vh="0">BLUENODE</button>
      <nav class="prototype-nav" aria-label="BlueNode prototype navigation">
        <button type="button" data-jump-vh="270">ABOUT</button>
        <button type="button" data-jump-vh="450">ACTIVITIES</button>
        <button type="button" data-jump-vh="940">RESEARCH</button>
        <button type="button" data-jump-vh="1160">NETWORK</button>
        <button type="button" data-jump-vh="1380">JOIN</button>
      </nav>
    </header>

    <div class="prototype-progress" aria-hidden="true">
      <span data-progress-fill></span>
    </div>

    <section
      class="prototype-scene scene-entry is-active"
      id="prototype-entry"
      data-scene="entry"
      data-scene-index="0"
      aria-labelledby="prototype-entry-heading"
    >
      <div class="responsive-scene-background responsive-scene-background--entry" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <header class="responsive-scene-header" aria-label="BlueNode mobile navigation">
        <button class="responsive-scene-header__brand" type="button">BLUENODE</button>
        <nav class="responsive-scene-header__actions" aria-label="Entry navigation">
          <button class="responsive-scene-header__join" type="button">JOIN</button>
          <button class="responsive-scene-header__menu" type="button">MENU</button>
        </nav>
      </header>

      <h1 class="entry-title display-type" id="prototype-entry-heading" data-entry-type>
        <span>THE STUDENT-LED</span>
        <span>BLOCKCHAIN RESEARCH CLUB</span>
        <span>BASED AT INHA UNIVERSITY</span>
      </h1>
      <div class="scroll-cue" aria-hidden="true" data-entry-scroll-cue>
        <span>SCROLL</span>
        <img
          src={withBase('/images/noomo-prototype/scroll-chevron.svg')}
          width="12"
          height="7"
          alt=""
        />
      </div>
    </section>

    <section
      class="prototype-scene scene-bluenode"
      id="prototype-bluenode"
      data-scene="bluenode"
      data-scene-index="1"
      aria-label="BlueNode identity pause"
      aria-hidden="true"
      inert
    >
      <div class="responsive-scene-background responsive-scene-background--bluenode" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <img
        class="bluenode-logo-lock"
        src={withBase('/images/noomo-prototype/bluenode-white-vertical.png')}
        width="443"
        height="265"
        alt="BlueNode"
        data-bluenode-logo
      />
    </section>

    <section
      class="prototype-scene scene-about"
      id="prototype-about"
      data-scene="about"
      data-scene-index="2"
      aria-labelledby="prototype-about-heading"
      aria-hidden="true"
      inert
    >
      <div class="responsive-scene-background responsive-scene-background--about" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <header class="responsive-scene-header" aria-label="BlueNode mobile navigation">
        <button class="responsive-scene-header__brand" type="button">BLUENODE</button>
        <nav class="responsive-scene-header__actions" aria-label="About navigation">
          <button class="responsive-scene-header__join" type="button">JOIN</button>
          <button class="responsive-scene-header__menu" type="button">MENU</button>
        </nav>
      </header>

      <h2 class="about-title display-type" id="prototype-about-heading" data-about-type>
        <span>BLUENODE</span>
        <span>WHERE THOSE WHO</span>
        <span>READ CHANGE AND ACT</span>
        <span>COME TOGETHER.</span>
      </h2>

      <div class="about-meta" data-about-meta>
        <span class="meta-pill">Community</span>
        <p>Web3 / Blockchain / Incheon</p>
      </div>

      <button class="prototype-pill-button about-cta" type="button" data-jump-vh="450" data-about-cta>
        <span>ABOUT BLUENODE</span>
        <span aria-hidden="true">→</span>
      </button>

      <div
        class="about-pengu"
        data-about-pengu
        style={`--pengu-mask: url("${withBase('/images/noomo-prototype/pengu-3d-mask.svg')}")`}
      >
        <img
          class="about-pengu__image"
          src={withBase('/images/noomo-prototype/pengu-3d-front.png')}
          width="2048"
          height="2048"
          alt="BlueNode mascot Pengu"
        />
      </div>
    </section>

    <section
      class="prototype-scene scene-activities"
      id="prototype-activities"
      data-scene="activities"
      data-scene-index="3"
      aria-labelledby="prototype-activities-heading"
      aria-hidden="true"
      inert
    >
      <div class="responsive-scene-background responsive-scene-background--activities" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <header class="responsive-scene-header" aria-label="BlueNode mobile navigation">
        <button class="responsive-scene-header__brand" type="button">BLUENODE</button>
        <nav class="responsive-scene-header__actions" aria-label="Activities navigation">
          <button class="responsive-scene-header__join" type="button">JOIN</button>
          <button class="responsive-scene-header__menu" type="button">MENU</button>
        </nav>
      </header>

      <h2 class="activities-word display-type" id="prototype-activities-heading" data-activities-word>
        ACTIVITIES
      </h2>

      <ol class="activities-rail" data-activities-rail aria-label="BlueNode activity highlights">
        {activityReel.map((activity, index) => (
          <li class="activities-card" data-activity-card data-card-index={index}>
            <figure>
              <img
                src={withBase(activity.src)}
                width={activity.width}
                height={activity.height}
                alt={activity.alt}
                loading={index > 1 ? 'lazy' : 'eager'}
                decoding="async"
                style={`object-position:${activity.objectPosition}`}
              />
            </figure>
          </li>
        ))}
      </ol>

      <div class="activities-titles" aria-live="polite">
        {activityReel.map((activity, index) => (
          <p class="display-type" data-activity-title data-title-index={index}>{activity.displayTitle}</p>
        ))}
      </div>

      <button class="prototype-pill-button activities-cta" type="button" data-jump-vh="450" data-activities-cta>
        <span>VIEW ACTIVITIES</span>
        <span aria-hidden="true">→</span>
      </button>
    </section>

    <section
      class="prototype-scene scene-awards"
      id="prototype-awards"
      data-scene="awards"
      data-scene-index="4"
      aria-labelledby="prototype-awards-heading"
      aria-hidden="true"
      inert
    >
      <div class="responsive-scene-background responsive-scene-background--awards" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <h2 class="awards-title display-type" id="prototype-awards-heading" data-awards-title>
        <span>RECOGNITION FOR</span>
        <span>DEDICATED WORK THAT</span>
        <span>TURNS WHAT WE LEARN</span>
        <span>INTO TANGIBLE OUTCOMES.</span>
      </h2>

      <ol
        class="awards-list"
        aria-label="Selected BlueNode awards"
        style={`--awards-divider: url("${withBase('/images/noomo-prototype/awards/award-divider.svg')}")`}
      >
        {awards.map((award) => (
          <li data-award-row>
            <span>{award}</span>
            <span aria-hidden="true">→</span>
          </li>
        ))}
      </ol>

      <p class="awards-count" data-awards-count>15 AWARDS / 2023—2026</p>
    </section>

    <section
      class="prototype-scene scene-research"
      id="prototype-research"
      data-scene="research"
      data-scene-index="5"
      aria-labelledby="prototype-research-heading"
      aria-hidden="true"
      inert
    >
      <div class="responsive-scene-background responsive-scene-background--research" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <header class="responsive-scene-header" aria-label="BlueNode mobile navigation">
        <button class="responsive-scene-header__brand" type="button">BLUENODE</button>
        <nav class="responsive-scene-header__actions" aria-label="Research navigation">
          <button class="responsive-scene-header__join" type="button">JOIN</button>
          <button class="responsive-scene-header__menu" type="button">MENU</button>
        </nav>
      </header>

      <h2 class="research-title display-type" id="prototype-research-heading" data-research-title>
        OUR RESEARCH
      </h2>

      <ol
        class="research-list"
        aria-label="Latest BlueNode research"
        style={`--research-divider-top: url("${withBase('/images/noomo-prototype/research/research-divider-top.svg')}"); --research-divider-row: url("${withBase('/images/noomo-prototype/research/research-divider.svg')}")`}
      >
        {research.map((article, index) => (
          <li data-research-row>
            <a href={article.externalUrl} target="_blank" rel="noopener noreferrer">
              <span class={`research-card research-card--${index + 1}`} aria-hidden="true">
                {article.thumbnail && (
                  <img
                    class="research-card__image"
                    src={withBase(article.thumbnail.src)}
                    width={article.thumbnail.width}
                    height={article.thumbnail.height}
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                )}
              </span>
              <strong>{article.title}</strong>
              <span class="research-meta">
                {researchDisplay[index].meta}&nbsp;&nbsp;·&nbsp;&nbsp;{formatResearchDisplayDate(article.publishedAt)}
              </span>
              <span class="research-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <a
        class="research-all"
        href="https://medium.com/bluenode"
        target="_blank"
        rel="noopener noreferrer"
        data-research-all
      >
        VIEW ALL
      </a>

      <p class="research-source" data-research-source>
        SOURCE&nbsp;&nbsp;·&nbsp;&nbsp;BLUENODE MEDIUM&nbsp;&nbsp;/&nbsp;&nbsp;ORIGINAL POST THUMBNAILS
      </p>
    </section>

    <section
      class="prototype-scene scene-network"
      id="prototype-network"
      data-scene="network"
      data-scene-index="6"
      aria-labelledby="prototype-network-heading"
      aria-hidden="true"
      inert
    >
      <div class="responsive-scene-background responsive-scene-background--network" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <header class="responsive-scene-header" aria-label="BlueNode mobile navigation">
        <button class="responsive-scene-header__brand" type="button">BLUENODE</button>
        <nav class="responsive-scene-header__actions" aria-label="Network navigation">
          <button class="responsive-scene-header__join" type="button">JOIN</button>
          <button class="responsive-scene-header__menu" type="button">MENU</button>
        </nav>
      </header>

      <h2 class="network-title display-type" id="prototype-network-heading" data-network-title>
        FROM INCHEON TO A WIDER WEB3 ECOSYSTEM.
      </h2>
      <p class="network-origin" data-network-origin>
        INHA UNIVERSITY<br />
        INCHEON, SOUTH KOREA
      </p>

      <div class="network-globe-stage" data-network-globe-stage>
        <div class="network-globe-fallback" data-network-fallback aria-hidden="true"></div>
        <div class="network-globe-reference" aria-hidden="true">
          <img
            class="network-globe-reference__outline"
            src={withBase('/images/noomo-prototype/network/network-globe-outline.svg')}
            width="1158"
            height="1158"
            alt=""
          />
          <span class="network-globe-reference__clip">
            <img
              class="network-globe-reference__grid"
              src={withBase('/images/noomo-prototype/network/network-globe-grid.svg')}
              width="1158"
              height="1158"
              alt=""
            />
          </span>
        </div>
        <canvas
          class="network-globe-canvas"
          width="1160"
          height="1160"
          role="img"
          aria-label="인천을 중심으로 국내외 Web3 생태계와 연결된 BlueNode 네트워크"
          data-network-canvas
        ></canvas>
      </div>

      <div class="network-connections" aria-hidden="true">
        <img
          class="network-route-layer network-route-layer--far"
          src={withBase('/images/noomo-prototype/network/network-global-routes.svg')}
          width="1440"
          height="900"
          alt=""
          data-network-far-routes
        />
        <img
          class="network-route-layer network-route-layer--domestic"
          src={withBase('/images/noomo-prototype/network/network-korea-routes.svg')}
          width="1440"
          height="900"
          alt=""
          data-network-domestic-routes
        />
      </div>

      <p class="network-hub" data-network-hub>INCHEON / BLUENODE HUB</p>

      <div class="network-labels network-labels--domestic" data-network-domestic aria-hidden="true">
        <span class="network-label label-dsrv">DSRV</span>
        <span class="network-label label-catalyze">CATALYZE RESEARCH</span>
        <span class="network-label label-four-pillars">FOUR PILLARS</span>
        <span class="network-label label-tiger">TIGER RESEARCH</span>
        <span class="network-label label-xangle">XANGLE</span>
        <span class="network-label label-altus">ALTUS</span>
      </div>
      <div class="network-labels network-labels--far" data-network-far aria-hidden="true">
        <span class="network-label label-tokyo">TOKYO / WEB3 JAPAN</span>
        <span class="network-label label-singapore">SINGAPORE / BLOCKCHAIN@NTU</span>
      </div>

      <button class="prototype-pill-button network-cta" type="button" data-jump-vh="1160" data-network-cta>
        <span>VIEW NETWORK</span>
        <span aria-hidden="true">→</span>
      </button>
    </section>

    <section
      class="prototype-scene scene-join"
      id="prototype-join"
      data-scene="join"
      data-scene-index="7"
      aria-labelledby="prototype-join-heading"
      aria-hidden="true"
      inert
    >
      <div class="responsive-scene-background responsive-scene-background--join" aria-hidden="true">
        {responsiveBackgroundOrbs.map((orb) => (
          <img
            class={`responsive-scene-background__orb responsive-scene-background__orb--${orb.name}`}
            src={withBase(orb.src)}
            width={orb.width}
            height={orb.height}
            alt=""
          />
        ))}
      </div>

      <header class="responsive-scene-header" aria-label="BlueNode mobile navigation">
        <button class="responsive-scene-header__brand" type="button">BLUENODE</button>
        <nav class="responsive-scene-header__actions" aria-label="Join navigation">
          <button class="responsive-scene-header__join" type="button">JOIN</button>
          <button class="responsive-scene-header__menu" type="button">MENU</button>
        </nav>
      </header>

      <h2 class="join-title display-type" id="prototype-join-heading" data-join-title>
        <span>IF WEB3 KEEPS YOU CURIOUS,</span>
        <span>WE WOULD LIKE TO MEET YOU.</span>
      </h2>

      <form class="join-form" data-join-form>
        <label class="join-field join-field--name" data-join-field>
          <span>YOUR NAME</span>
          <input type="text" name="name" autocomplete="name" aria-label="Your name" />
        </label>

        <label class="join-field join-field--email" data-join-field>
          <span>YOUR EMAIL</span>
          <input type="email" name="email" autocomplete="email" aria-label="Your email" />
        </label>

        <label class="join-field join-field--curiosity" data-join-field>
          <span>WHAT KEEPS YOU CURIOUS?</span>
          <textarea name="curiosity" rows="1" aria-label="What keeps you curious?"></textarea>
        </label>

        <fieldset class="join-interests" data-join-interests>
          <legend>I’M INTERESTED IN</legend>
          <button type="button" aria-pressed="false">RESEARCH</button>
          <button type="button" aria-pressed="false">DEVELOPMENT</button>
          <button type="button" aria-pressed="false">DEGEN</button>
        </fieldset>

        <button class="join-submit" type="submit" data-join-submit>
          <span>MEET BLUENODE</span>
          <span aria-hidden="true">→</span>
        </button>
      </form>

      <footer class="join-footer" data-join-footer>
        INHA UNIVERSITY&nbsp; · &nbsp;INCHEON&nbsp; · &nbsp;SINCE 2023
      </footer>
    </section>
  </div>
</main>

<script>
  import '../../scripts/noomo-prototype'
</script>
