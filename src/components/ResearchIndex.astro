---
import type { FeedArticle } from '../lib/medium'
import { getMembersByHandles } from '../data/members'
import { formatResearchDate } from '../data/research'
import { withBase } from '../lib/paths'

interface Props {
  articles: FeedArticle[]
}

const { articles } = Astro.props
const featuredArticles = articles.slice(0, 3)
const mediumChannelUrl = 'https://medium.com/bluenode'
const initialArticle = featuredArticles[0]
const getArticleAuthors = (article: FeedArticle) => {
  if (article.authorNames?.length) return article.authorNames
  return getMembersByHandles(article.authorHandles).map((author) => author.displayName)
}
const getArticleMetadata = (article: FeedArticle) => {
  const authors = getArticleAuthors(article)
  return [formatResearchDate(article.publishedAt), authors.join(', ')]
    .filter(Boolean)
    .join(' · ')
}
const getArticleTags = (article: FeedArticle) => article.tags.slice(0, 2).join(' · ')
const initialArticleMetadata = initialArticle ? getArticleMetadata(initialArticle) : ''
const initialArticleTags = initialArticle ? getArticleTags(initialArticle) : ''
---

<section
  class="research-index on-light"
  id="research"
  aria-labelledby="research-index-heading"
  data-research-index
>
  <h2 class="research-index__heading" id="research-index-heading">research</h2>

  <div class="research-index__content">
    <ol class="research-index__list" aria-label="BlueNode Medium 최신 리서치">
      {featuredArticles.map((article, index) => {
        const metadata = getArticleMetadata(article)
        const tags = getArticleTags(article)

        return (
          <li class="research-index__item">
            <a
              class="research-index__article"
              href={article.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-research-article
              data-research-active={index === 0 ? 'true' : 'false'}
              data-article-title={article.title}
              data-article-url={article.externalUrl}
              data-article-meta={metadata}
              data-article-summary={article.snippet}
              data-article-tags={tags}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <span class="research-index__divider" aria-hidden="true"></span>
              <span class="research-index__meta">{metadata}</span>
              <span class="research-index__title">{article.title}</span>
            </a>
          </li>
        )
      })}
    </ol>

    {initialArticle && (
      <a
        class="research-index__preview"
        href={initialArticle.externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`선택된 글: ${initialArticle.title}`}
        data-research-preview
      >
        <span class="research-index__preview-label">Selected article</span>
        <span class="research-index__symbol" aria-hidden="true">
          <img src={withBase('images/bluenode-symbol-entry.svg')} alt="" width="360" height="332" />
        </span>
        <span class="research-index__preview-body">
          <span class="research-index__preview-meta" data-research-preview-meta>
            {initialArticleMetadata}
          </span>
          <strong class="research-index__preview-title" data-research-preview-title>
            {initialArticle.title}
          </strong>
          <span
            class="research-index__preview-summary"
            data-research-preview-summary
            hidden={!initialArticle.snippet}
          >
            {initialArticle.snippet}
          </span>
          <span
            class="research-index__preview-tags"
            data-research-preview-tags
            hidden={!initialArticleTags}
          >
            {initialArticleTags}
          </span>
        </span>
        <span class="research-index__preview-source">
          <span>Read on Medium</span>
          <span class="research-index__preview-arrow" aria-hidden="true">↗</span>
        </span>
      </a>
    )}
  </div>

  <a
    class="research-index__footer"
    href={mediumChannelUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span>View all research on Medium</span>
    <span class="research-index__arrow" aria-hidden="true">→</span>
  </a>
</section>

<script>
  const researchIndex = document.querySelector<HTMLElement>('[data-research-index]')
  const researchPreview = researchIndex?.querySelector<HTMLAnchorElement>('[data-research-preview]')
  const researchPreviewMeta = researchPreview?.querySelector<HTMLElement>('[data-research-preview-meta]')
  const researchPreviewTitle = researchPreview?.querySelector<HTMLElement>('[data-research-preview-title]')
  const researchPreviewSummary = researchPreview?.querySelector<HTMLElement>('[data-research-preview-summary]')
  const researchPreviewTags = researchPreview?.querySelector<HTMLElement>('[data-research-preview-tags]')
  const researchArticles = researchIndex
    ? [...researchIndex.querySelectorAll<HTMLAnchorElement>('[data-research-article]')]
    : []
  const entryHeader = document.querySelector<HTMLElement>('[data-entry-header]')
  let researchHeaderFrame = 0

  const selectResearchArticle = (article: HTMLAnchorElement) => {
    researchArticles.forEach((candidate) => {
      const active = candidate === article
      candidate.dataset.researchActive = String(active)
      if (active) candidate.setAttribute('aria-current', 'true')
      else candidate.removeAttribute('aria-current')
    })

    if (!researchPreview) return
    const title = article.dataset.articleTitle
    const url = article.dataset.articleUrl
    const metadata = article.dataset.articleMeta ?? ''
    const summary = article.dataset.articleSummary ?? ''
    const tags = article.dataset.articleTags ?? ''
    if (title) researchPreview.setAttribute('aria-label', `선택된 글: ${title}`)
    if (url) researchPreview.href = url
    if (researchPreviewMeta) researchPreviewMeta.textContent = metadata
    if (researchPreviewTitle) researchPreviewTitle.textContent = title ?? ''
    if (researchPreviewSummary) {
      researchPreviewSummary.textContent = summary
      researchPreviewSummary.hidden = !summary
    }
    if (researchPreviewTags) {
      researchPreviewTags.textContent = tags
      researchPreviewTags.hidden = !tags
    }
  }

  researchArticles.forEach((article) => {
    article.addEventListener('pointerenter', () => selectResearchArticle(article))
    article.addEventListener('focus', () => selectResearchArticle(article))
  })

  if (researchIndex) {
    const syncResearchHeader = () => {
      researchHeaderFrame = 0
      const rect = researchIndex.getBoundingClientRect()
      entryHeader?.classList.toggle('hdr--research-active', rect.top < innerHeight && rect.bottom > 0)
    }

    const requestResearchHeaderSync = () => {
      if (!researchHeaderFrame) researchHeaderFrame = requestAnimationFrame(syncResearchHeader)
    }

    addEventListener('scroll', requestResearchHeaderSync, { passive: true })
    addEventListener('resize', requestResearchHeaderSync, { passive: true })
    syncResearchHeader()
  }
</script>
