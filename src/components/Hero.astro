---
import { withBase } from '../lib/paths'
---

<section class="entry on-light" id="top" aria-labelledby="entry-title" data-entry>
  <div class="entry__stage" data-entry-stage>
    <div class="entry__symbol" aria-hidden="true">
      <div class="entry__reveal entry__reveal--symbol">
        <img
          src={withBase('images/bluenode-symbol-primary.svg')}
          width="150"
          height="139"
          alt=""
          loading="eager"
          decoding="sync"
        />
      </div>
    </div>

    <div class="entry__slogan">
      <h1 id="entry-title" class="entry__slogan-text">
        변화를 읽고<br />움직이는 사람들이 모이는 곳
      </h1>
    </div>

    <div class="entry__wordmark" aria-hidden="true">
      <p class="entry__wordmark-text">BlueNode</p>
    </div>
  </div>
</section>

<script>
  const entry = document.querySelector<HTMLElement>('[data-entry]')
  const entryHeader = document.querySelector<HTMLElement>('[data-entry-header]')
  let entryFrame = 0

  const renderEntry = () => {
    entryFrame = 0
    if (!entry) return

    const rect = entry.getBoundingClientRect()
    entryHeader?.classList.toggle('hdr--entry-past', rect.bottom <= 1)
  }

  const requestEntryRender = () => {
    if (!entryFrame) entryFrame = requestAnimationFrame(renderEntry)
  }

  addEventListener('scroll', requestEntryRender, { passive: true })
  addEventListener('resize', requestEntryRender, { passive: true })
  renderEntry()
</script>
